    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "# Берем данные GW150914 (как в первом коде)\n",
        "gps = event_gps(\"GW150914\")\n",
        "# Загружаем чуть больше данных для точного анализа частот\n",
        "data_qnm = TimeSeries.fetch_open_data(\"H1\", gps - 0.2, gps + 0.2)\n",
        "\n",
        "# Применяем спектральный анализ (преобразование Фурье)\n",
        "# Это разбивает сигнал на частоты (как эквалайзер в музыке)\n",
        "asd = data_qnm.asd(fftlength=0.2)\n",
        "\n",
        "# Строим график (логарифмическая шкала по обеим осям)\n",
        "plt.figure(figsize=(12, 5))\n",
        "plt.loglog(asd.frequencies, asd, color='green', linewidth=1.5)\n",
        "plt.title(\"Спектральный анализ: Поиск частот (QNM) черной дыры\")\n",
        "plt.xlabel(\"Частота (Гц)\")\n",
        "plt.ylabel(\"Амплитуда\")\n",
        "plt.xlim(20, 500) # Ограничиваем диапазон, где LIGO наиболее чувствителен\n",
        "plt.grid(True, which=\"both\", ls=\"--\")\n",
        "plt.show()\n",
        "\n",
        "print(\"Этот график показывает, на каких частотах 'звенит' черная дыра.\")\n",
        "print(\"Пики на графике — это и есть квазинормальные моды (QNM).\")\n",
        "print(\"В теориях квантовой гравитации положение этих пиков может немного смещаться.\")"
